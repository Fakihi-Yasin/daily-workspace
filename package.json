{
  "name": "tableau-de-bord-local",
  "version": "1.0.0",
  "private": true,
  "description": "Personal, local-first, offline work dashboard.",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "build": "node scripts/build.js",
    "build:test": "AUTH_PROVIDER=test node scripts/build.js",
    "preview": "node scripts/preview.js dist 4322",
    "test": "node --test test/flows.test.js test/local-backend.test.js test/cloud-sync.test.js test/v2-features.test.js",
    "check:rls": "node scripts/check-rls.mjs"
  },
  "devDependencies": {
    "@auth0/auth0-spa-js": "2.1.3",
    "esbuild": "0.24.0",
    "sql.js": "1.11.0"
  }
}
