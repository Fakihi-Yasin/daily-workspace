# Vercel → Project → Settings → Environment Variables. All values here are PUBLIC identifiers.
# Never put the Supabase database password or the secret / service_role key here or in Vercel.

# Auth0 Single Page Application (no client secret is used)
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id

# Cloud sync (optional). Leave all three unset for browser-only storage (V1).
AUTH0_AUDIENCE=https://daily-workspace-sync
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
